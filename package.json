{
  "name": "agents-factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "probe:terminal-close": "node src/daemon/fixtures/terminal-probe.ts",
    "probe:keys": "node src/tui/key-probe.ts",
    "demo": "node src/demo/demo.ts",
    "media": "node src/demo/record.ts",
    "tapes": "node src/demo/tapes.ts",
    "media:vhs": "node src/demo/tapes.ts --record"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "chalk": "6.0.1",
    "ink": "8.0.0",
    "react": "19.3.1",
    "typescript-6": "npm:typescript@6.0.3",
    "typescript-language-server": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "dejavu-fonts-ttf": "2.37.3",
    "gifenc": "1.0.3",
    "ink-testing-library": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "bin": {
    "agents-factory": "src/cli.ts"
  }
}
